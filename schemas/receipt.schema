$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://example.org/lopas/schemas/receipt.schema.yaml"
title: "LoPAS Verifiable Receipt"
type: object
additionalProperties: false
required:
  - receipt_id
  - receipt_type
  - subject
  - claim
  - integrity
  - verification
  - issued_at

properties:
  receipt_id:
    type: string

  receipt_type:
    type: string
    enum:
      - capability
      - routing
      - execution
      - validation
      - settlement
      - correction
      - no_change
      - other

  issued_at:
    type: string
    format: date-time

  subject:
    type: object
    additionalProperties: true
    required:
      - subject_id
    properties:
      subject_id:
        type: string
      subject_type:
        type: [string, "null"]

  claim:
    type: object
    additionalProperties: true
    required:
      - statement
    properties:
      statement:
        type: string
      value:
        type: ["string", "number", "integer", "boolean", "object", "array", "null"]
      unit:
        type: [string, "null"]
      semantics:
        type: object
        additionalProperties: true

  evidence:
    type: object
    additionalProperties: true
    properties:
      evidence_refs:
        type: array
        items:
          type: string
      encrypted:
        type: boolean
        default: false
      encryption:
        type: object
        additionalProperties: true
        properties:
          algorithm:
            type: [string, "null"]
          key_ref:
            type: [string, "null"]
          ciphertext_ref:
            type: [string, "null"]

  integrity:
    type: object
    additionalProperties: false
    required:
      - payload_hash
    properties:
      canonicalization:
        type: [string, "null"]
      semantic_hash:
        type: [string, "null"]
      payload_hash:
        type: string
      previous_receipt_hash:
        type: [string, "null"]
      signer_id:
        type: [string, "null"]
      signature_algorithm:
        type: [string, "null"]
      signature:
        type: [string, "null"]
      timestamp_proof:
        type: [string, "null"]

  verification:
    type: object
    additionalProperties: false
    required:
      - status
    properties:
      status:
        type: string
        enum:
          - verified
          - partially_verified
          - media_report_only
          - unverified
          - simulated
      verifier_id:
        type: [string, "null"]
      verified_at:
        type: [string, "null"]
        format: date-time
      notes:
        type: [string, "null"]
