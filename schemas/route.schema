$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://example.org/lopas/schemas/route.schema.yaml"
title: "LoPAS Route Decision"
type: object
additionalProperties: false
required:
  - route_id
  - workload_ref
  - candidates
  - selected
  - decision
  - validation

properties:
  route_id:
    type: string

  workload_ref:
    type: string

  observed_at:
    type: string
    format: date-time

  candidates:
    type: array
    minItems: 1
    items:
      type: object
      additionalProperties: false
      required:
        - node_id
        - capability_refs
        - eligibility
      properties:
        node_id:
          type: string
        capability_refs:
          type: array
          items:
            type: string
        eligibility:
          type: string
          enum:
            - eligible
            - ineligible
            - uncertain
        rejection_reasons:
          type: array
          items:
            type: string
        scores:
          type: object
          additionalProperties:
            type: number

  selected:
    type: object
    additionalProperties: false
    required:
      - node_id
      - capability_refs
    properties:
      node_id:
        type: string
      capability_refs:
        type: array
        items:
          type: string

  decision:
    type: object
    additionalProperties: false
    required:
      - status
      - reason
    properties:
      status:
        type: string
        enum:
          - selected
          - hold
          - review
          - rejected
      reason:
        type: string
      policy_id:
        type: [string, "null"]
      policy_version:
        type: [string, "null"]
      decided_by:
        type: [string, "null"]
      human_approval:
        type: [boolean, "null"]
      confidence:
        type: [number, "null"]
        minimum: 0
        maximum: 1

  expected_impact:
    type: object
    additionalProperties: true
    properties:
      energy_kwh:
        type: [number, "null"]
      cost_jpy:
        type: [number, "null"]
      carbon_kg:
        type: [number, "null"]
      latency_ms:
        type: [number, "null"]

  validation:
    type: object
    additionalProperties: false
    required:
      - status
    properties:
      status:
        type: string
        enum:
          - verified
          - partially_verified
          - unverified
          - simulated
      evidence_refs:
        type: array
        items:
          type: string
      decision_hash:
        type: [string, "null"]
      signature:
        type: [string, "null"]
